# .env.example
# Primary Notification Recipient
CONTACT_EMAIL=olabel@gmail.com

# 3rd-Party Email Service Options (Provide at least one for live delivery)
# Option 1: Resend (Official SDK - recommended, fast & modern email API)
RESEND_API_KEY=
# Optional: Set your verified sender address (e.g. Oakivo Security <notifications@yourdomain.com>)
# If your domain is not verified yet in Resend, the system automatically uses onboarding@resend.dev
RESEND_FROM=Oakivo Security <notifications@oakivo.com>
EMAIL_FROM=notifications@oakivo.com

# Option 2: SendGrid API
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=notifications@oakivo.com

# Option 3: Brevo (Sendinblue) API
BREVO_API_KEY=
BREVO_FROM_EMAIL=notifications@oakivo.com

# Option 4: SMTP Configuration (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# Gemini API Key for AI Chatbot
GEMINI_API_KEY=
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
