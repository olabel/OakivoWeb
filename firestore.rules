rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /entries/{document=**} {
      // Anyone can submit a lead form
      allow create: if true;
      // Only authenticated admins can view and manage leads
      allow read, update, delete: if request.auth != null;
    }
    match /analytics_events/{document=**} {
      // Anyone (including unauthenticated visitors) can write an analytics event
      allow create: if true;
      // Only authenticated admins can read or manage analytics
      allow read, update, delete: if request.auth != null;
    }
  }
}
