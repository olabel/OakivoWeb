rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /entries/{document=**} {
      // Validate schema for public creations to prevent malicious payloads
      allow create: if request.resource.data.keys().hasAll(['createdAt', 'type', 'data', 'status'])
                    && request.resource.data.type in ['lead', 'applicant', 'subscriber']
                    && request.resource.data.status == 'new'
                    && request.resource.data.createdAt is string
                    && request.resource.data.data is map;
                    
      // Only authenticated admins can view and manage leads
      allow read, update, delete: if request.auth != null;
    }
    match /analytics_events/{document=**} {
      // Validate schema for analytics to prevent spam/abuse
      allow create: if request.resource.data.keys().hasAll(['path', 'timestamp', 'sessionId'])
                    && request.resource.data.path is string
                    && request.resource.data.timestamp is string;
                    
      // Only authenticated admins can read or manage analytics
      allow read, update, delete: if request.auth != null;
    }
  }
}
