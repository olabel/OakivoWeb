{
  "entities": {
    "Entry": {
      "title": "Entry",
      "description": "Lead, job application, or newsletter subscription submission",
      "type": "object",
      "properties": {
        "createdAt": { "type": "string" },
        "type": { "type": "string", "enum": ["lead", "applicant", "subscriber"] },
        "data": { "type": "object" },
        "status": { "type": "string", "enum": ["new", "processed", "archived"] }
      },
      "required": ["createdAt", "type", "data", "status"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "description": "Newsletter subscriber record",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "source": { "type": "string" },
        "subscribedAt": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["email", "subscribedAt"]
    },
    "Insight": {
      "title": "Insight",
      "description": "Security research article or briefing",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "excerpt": { "type": "string" },
        "date": { "type": "string" },
        "readTime": { "type": "string" },
        "author": { "type": "string" },
        "coverImage": { "type": "string" },
        "content": { "type": "string" }
      },
      "required": ["title", "category", "date"]
    },
    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "Page view tracking telemetry event",
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "title": { "type": "string" },
        "timestamp": { "type": "string" },
        "referrer": { "type": "string" },
        "userAgent": { "type": "string" },
        "device": { "type": "string", "enum": ["Desktop", "Mobile", "Tablet"] },
        "location": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "sessionId": { "type": "string" }
      },
      "required": ["path", "timestamp", "sessionId"]
    },
    "SecurityScan": {
      "title": "SecurityScan",
      "description": "Automated cloud perimeter, container, and policy security scan record",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string" },
        "target": { "type": "string" },
        "overallScore": { "type": "number" },
        "status": { "type": "string", "enum": ["completed", "in_progress", "failed"] },
        "criticalCount": { "type": "number" },
        "highCount": { "type": "number" },
        "mediumCount": { "type": "number" },
        "checksPassed": { "type": "number" },
        "totalChecks": { "type": "number" },
        "durationMs": { "type": "number" },
        "scannerType": { "type": "string" }
      },
      "required": ["timestamp", "target", "overallScore", "status"]
    },
    "IncidentRemediation": {
      "title": "IncidentRemediation",
      "description": "Automated security incident detection and autonomous remediation record",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
        "remediationTimeMs": { "type": "number" },
        "actionTaken": { "type": "string" },
        "targetResource": { "type": "string" },
        "estimatedValueSaved": { "type": "string" },
        "status": { "type": "string", "enum": ["neutralized", "auto_remediated", "quarantined"] },
        "forensicDetails": { "type": "string" }
      },
      "required": ["timestamp", "title", "severity", "actionTaken", "status"]
    }
  },
  "firestore": {
    "/entries/{entryId}": {
      "schema": { "$ref": "#/entities/Entry" },
      "description": "Collection of form leads, applicants, and subscribers"
    },
    "/subscribers/{subscriberId}": {
      "schema": { "$ref": "#/entities/Subscriber" },
      "description": "Collection of newsletter subscribers"
    },
    "/insights/{insightId}": {
      "schema": { "$ref": "#/entities/Insight" },
      "description": "Security insight articles and publications"
    },
    "/analytics_events/{eventId}": {
      "schema": { "$ref": "#/entities/AnalyticsEvent" },
      "description": "Real-time client page view analytics events"
    },
    "/security_scans/{scanId}": {
      "schema": { "$ref": "#/entities/SecurityScan" },
      "description": "Automated security scan executions and posture evaluations"
    },
    "/incident_remediations/{remediationId}": {
      "schema": { "$ref": "#/entities/IncidentRemediation" },
      "description": "Automated threat neutralizations and incident remediations"
    }
  }
}
